{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {"source":"/assets/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/models/versioned/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {"source":"/(simple|privacy|terms|cancellation)","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]}
  ],
  "rewrites":[
    {"source":"/simple","destination":"/simple/index.html"},
    {"source":"/privacy","destination":"/privacy/index.html"},
    {"source":"/terms","destination":"/terms/index.html"},
    {"source":"/cancellation","destination":"/cancellation/index.html"}
  ]
}
