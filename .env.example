# Public build settings — included in the browser. Replace before launch.
VITE_SITE_URL=https://egal.example
# Defaults to the Vercel function /api/booking.
# VITE_BOOKING_ENDPOINT=/api/booking

# SERVER ONLY. Configure these in Vercel environment settings; never use VITE_ prefixes.
RESEND_API_KEY=
BOOKING_TO_EMAIL=
BOOKING_FROM_EMAIL=

# Analytics stays fully off without an ID AND HTTPS tracker URL.
# Use the manual/custom-event script from the selected provider dashboard.
VITE_ANALYTICS_ID=
VITE_ANALYTICS_PROVIDER=umami
VITE_ANALYTICS_SCRIPT_URL=
